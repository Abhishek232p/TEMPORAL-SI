{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "temporal-intelligence-api": {
      "root": ".",
      "framework": "fastapi",
      "buildCommand": "pip install -r requirements.txt"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/chat",
      "destination": {
        "service": "temporal-intelligence-api"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "temporal-intelligence-api"
      }
    },
    {
      "source": "/organizations/(.*)",
      "destination": {
        "service": "temporal-intelligence-api"
      }
    },
    {
      "source": "/projects/(.*)",
      "destination": {
        "service": "temporal-intelligence-api"
      }
    },
    {
      "source": "/datasets/(.*)",
      "destination": {
        "service": "temporal-intelligence-api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "temporal-intelligence-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
